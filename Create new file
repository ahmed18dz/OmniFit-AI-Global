:root { --neon: #00ff88; --purple: #8a2be2; --bg: #050505; }
body { background: var(--bg); color: white; font-family: sans-serif; margin: 0; padding-bottom: 80px; }
header { padding: 20px; display: flex; justify-content: space-between; border-bottom: 1px solid #222; background: #000; }
.logo { font-weight: 900; color: var(--neon); text-transform: uppercase; }
.container { padding: 20px; }
.page { display: none; }
.active-page { display: block; animation: fadeIn 0.3s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
#vision-box { width: 100%; border-radius: 20px; overflow: hidden; border: 2px solid var(--neon); position: relative; aspect-ratio: 4/3; background: #111; }
video, canvas { position: absolute; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
.card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 15px; margin-top: 15px; border-left: 4px solid var(--neon); }
.btn-start { background: var(--neon); color: #000; border: none; padding: 20px; width: 100%; border-radius: 15px; font-weight: 900; cursor: pointer; }
nav { position: fixed; bottom: 0; width: 100%; background: #000; display: flex; justify-content: space-around; padding: 15px 0; border-top: 1px solid #222; }
nav i { color: #555; font-size: 24px; cursor: pointer; }
nav i.active { color: var(--neon); }
