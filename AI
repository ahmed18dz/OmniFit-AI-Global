<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OmniFit AI | Professional Edition</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@3.11.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/posenet@2.2.2"></script>

    <style>
        :root { --neon: #00ff88; --purple: #8a2be2; --bg: #050505; }
        body { background: var(--bg); color: white; font-family: sans-serif; margin: 0; padding-bottom: 80px; }
        
        header { padding: 20px; display: flex; justify-content: space-between; border-bottom: 1px solid #222; background: #000; }
        .logo { font-weight: 900; color: var(--neon); text-transform: uppercase; }

        .container { padding: 20px; }
        
        /* نظام الصفحات */
        .page { display: none; animation: fadeIn 0.3s; }
        .active-page { display: block; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* الكاميرا */
        #vision-box { width: 100%; border-radius: 20px; overflow: hidden; border: 2px solid var(--neon); position: relative; aspect-ratio: 4/3; background: #111; }
        video, canvas { position: absolute; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }

        .card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 15px; margin-top: 15px; border-left: 4px solid var(--neon); }
        
        .btn-start { background: var(--neon); color: #000; border: none; padding: 20px; width: 100%; border-radius: 15px; font-weight: 900; cursor: pointer; margin-top: 15px; }

        /* القائمة السفلية - تأكد من الضغط على الأيقونات */
        nav { position: fixed; bottom: 0; width: 100%; background: #000; display: flex; justify-content: space-around; padding: 15px 0; border-top: 1px solid #222; z-index: 1000; }
        nav i { color: #555; font-size: 24px; cursor: pointer; transition: 0.3s; }
        nav i.active { color: var(--neon); }
    </style>
</head>
<body>

<header>
    <div class="logo">OmniFit AI</div>
    <div id="status" style="font-size: 12px;">SYSTEM READY</div>
</header>

<div class="container">
    <div id="home-page" class="page active-page">
        <div id="vision-box">
            <video id="video" playsinline muted></video>
            <canvas id="canvas"></canvas>
        </div>
        <button class="btn-start" onclick="startCamera()">ACTIVATE AI COACH</button>
        <div class="card">
            <h3>Daily Goal</h3>
            <p>Complete 20 squats to unlock pro level.</p>
        </div>
    </div>

    <div id="coach-page" class="page">
        <h2>Coach Dashboard</h2>
        <div class="card">
            <h4>Live Clients</h4>
            <p>You have 0 active clients right now.</p>
        </div>
        <div class="card">
            <h4>Earnings</h4>
            <p>$0.00 - Connect Stripe to start.</p>
        </div>
    </div>

    <div id="settings-page" class="page">
        <h2>Settings</h2>
        <div class="card">
            <p>Language: English (Primary)</p>
            <p>AI Voice: Enabled</p>
        </div>
    </div>
</div>

<nav>
    <i class="fas fa-home active" onclick="navTo('home-page', this)"></i>
    <i class="fas fa-dumbbell" onclick="navTo('coach-page', this)"></i>
    <i class="fas fa-cog" onclick="navTo('settings-page', this)"></i>
</nav>

<script>
    // نظام التنقل بين الصفحات
    function navTo(pageId, element) {
        // إخفاء كل الصفحات
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active-page'));
        // إظهار الصفحة المطلوبة
        document.getElementById(pageId).classList.add('active-page');
        
        // تغيير لون الأيقونات
        document.querySelectorAll('nav i').forEach(i => i.classList.remove('active'));
        element.classList.add('active');
    }

    // كود الكاميرا والذكاء الاصطناعي
    async function startCamera() {
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        
        document.getElementById('status').innerText = "AI BOOTING...";
        
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = stream;
            video.play();
            
            const net = await posenet.load();
            document.getElementById('status').innerText = "TRACKING LIVE";

            function detect() {
                net.estimateSinglePose(video).then(pose => {
                    ctx.clearRect(0,0,canvas.width, canvas.height);
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                    
                    pose.keypoints.forEach(kp => {
                        if(kp.score > 0.5) {
                            ctx.fillStyle = "#00ff88";
                            ctx.beginPath();
                            ctx.arc(kp.position.x, kp.position.y, 5, 0, 2*Math.PI);
                            ctx.fill();
                        }
                    });
                    requestAnimationFrame(detect);
                });
            }
            detect();
        } catch(e) {
            alert("Camera error: Please use HTTPS and allow access.");
        }
    }
</script>

</body>
</html>
